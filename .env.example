# =============================================================================
# .env.example — Copiar a .env y ajustar valores según su entorno.
# El proyecto NO carga automáticamente un archivo .env (no se usa
# python-dotenv para mantener las dependencias mínimas); exporte estas
# variables en su shell antes de ejecutar main.py, por ejemplo:
#
#   export CPYD_SEED=42
#   export CPYD_N_JOBS=4
#   python main.py --input data/ventas_completas.csv
# =============================================================================

# Semilla de reproducibilidad para TODO proceso aleatorio del proyecto
# (split train/test, inicialización de K-means, submuestreo en tests de
# normalidad). Si no se define, el proyecto usa 42 por defecto.
CPYD_SEED=42

# Número de procesos worker para el algoritmo paralelo explícito
# (src/parallel_stats.py). Si no se define, se usan todos los núcleos
# lógicos disponibles (os.cpu_count()).
CPYD_N_JOBS=4
